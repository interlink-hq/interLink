# Image for the SSH port-forward shadow pod (Network.ShadowMode: ssh).
#
# It forwards the pod's ports with stock ssh, through an HPC login node and, with
# Network.SSH.ForwardTarget "node", to the compute node's own sshd (ssh-keygen, from
# openssh-client, checks node host keys). For GSSAPI sites it needs the Kerberos
# client tools to obtain and renew a ticket from a keytab. socat provides the local
# listeners of Network.SSH.ForwardMode "exec", where no sshd grants forwarding.
# Nothing from this repository is installed: the shadow runs no interLink binary,
# only stock ssh.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssh-client krb5-user socat ca-certificates \
 && rm -rf /var/lib/apt/lists/*

CMD ["/bin/sh"]
